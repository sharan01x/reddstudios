---

<BaseLayout title="Redd XF" canonicalPath="/">
    <div class="container">
        <div class="header">
            <h1>Redd XF</h1>
            <div class="subtitle">For the Post-Skill Designer</div>
            <div style="margin-top: 20px;">
                <a href="https://reddxf.substack.com" class="rss-link" target="_blank" rel="noopener">
                    <i class="fas fa-envelope"></i> Subscribe
                </a>
                <a href="/rss.xml" class="rss-link" style="margin-left: 15px;">
                    <i class="fas fa-rss"></i> RSS
                </a>
            </div>
        </div>
        
        <!-- Mobile Hamburger Menu -->
        <button class="mobile-menu-toggle" aria-label="Toggle Menu">
            <i class="fas fa-bars"></i>
        </button>
        
        <!-- Tabs Navigation -->
        <div class="tabs-container">
            <div class="tabs-nav">
                <a href="#articles" class="tab-button active" data-tab="articles"><i class="fas fa-newspaper"></i>Articles</a>
                <a href="#audio" class="tab-button" data-tab="audio"><i class="fas fa-headphones"></i>Audio</a>
                <a href="#podcasts" class="tab-button" data-tab="podcasts"><i class="fas fa-podcast"></i>Podcasts</a>
                <a href="#videos" class="tab-button" data-tab="videos"><i class="fas fa-video"></i>Videos</a>
                <a href="#art" class="tab-button" data-tab="art"><i class="fas fa-palette"></i>Art</a>
                <a href="#posts" class="tab-button" data-tab="posts"><i class="fas fa-comment-dots"></i>Posts</a>
            </div>
        </div>
        
        <!-- Mobile Menu Dropdown -->
        <div class="mobile-menu-dropdown">
            <a href="#articles" class="mobile-menu-item active" data-tab="articles"><i class="fas fa-newspaper"></i>Articles</a>
            <a href="#audio" class="mobile-menu-item" data-tab="audio"><i class="fas fa-headphones"></i>Audio</a>
            <a href="#podcasts" class="mobile-menu-item" data-tab="podcasts"><i class="fas fa-podcast"></i>Podcasts</a>
            <a href="#videos" class="mobile-menu-item" data-tab="videos"><i class="fas fa-video"></i>Videos</a>
            <a href="#art" class="mobile-menu-item" data-tab="art"><i class="fas fa-palette"></i>Art</a>
            <a href="#posts" class="mobile-menu-item" data-tab="posts"><i class="fas fa-comment-dots"></i>Posts</a>
        </div>
        
        <!-- Articles Tab Content -->
        <div id="articles-tab" class="tab-content active">
            <div class="tags-cloud" id="articles-tags-cloud">
                <button class="tag-filter active" data-tag="all" data-scope="articles">All</button>
                {articleTags.map(tag => (
                    <button class="tag-filter" data-tag={tag} data-scope="articles">{tag}</button>
                ))}
            </div>
            <div class="articles-list">
                {articles.map((article) => (
                    <div class="article-item" data-tags={article.data.tags.join(' ')}>
                        {article.data.image && (
                            <div class="article-image">
                                <a href={`/articles/${article.id.replace(/\.md$/, '')}/`}>
                                    <img src={`/${article.data.image}`} alt={article.data.title} loading="lazy">
                                </a>
                            </div>
                        )}
                        <div class="article-content">
                            <div class="article-header">
                                <h2><a href={`/articles/${article.id.replace(/\.md$/, '')}/`}>{article.data.title}</a></h2>
                                <div class="article-subtitle">{article.data.subtitle}</div>
                            </div>
                            <div class="article-meta">
                                <span class="article-date">{formatDate(article.data.date)}</span>
                                <span class="article-author">by {article.data.author}</span>
                            </div>
                            <div class="article-tags">
                                {article.data.tags.map(tag => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
        
        <!-- Audio Tab Content -->
        <div id="audio-tab" class="tab-content">
            <div class="playlist-container">
                {audioArticles.map((article, index) => (
                    <div class="playlist-item" data-index={index}>
                        <div class="playlist-number">{index + 1}</div>
                        <div class="playlist-info">
                            <div class="playlist-title">{article.data.title}</div>
                            <div class="playlist-subtitle">{article.data.subtitle}</div>
                            <div class="playlist-meta">
                                <span class="playlist-author">{article.data.author}</span>
                                <span class="playlist-date">{formatDate(article.data.date)}</span>
                            </div>
                            <div class="playlist-tags">
                                {article.data.tags.map(tag => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                        <div class="playlist-player">
                            <audio class="audio-player" data-index={index} data-article-title={article.data.title} data-audio-type="reader" controls preload="none">
                                <source src={article.data.audio} type="audio/mpeg">
                            </audio>
                        </div>
                    </div>
                ))}
            </div>
        </div>
        
        <!-- Podcasts Tab Content -->
        <div id="podcasts-tab" class="tab-content">
            <div class="playlist-container">
                {podcastArticles.map((article, index) => (
                    <div class="playlist-item podcast" data-index={index}>
                        <div class="podcast-artwork-container">
                            <div class="podcast-artwork-placeholder"></div>
                        </div>
                        <div class="playlist-info">
                            <div class="podcast-episode-badge">S1E{index + 1}</div>
                            <div class="playlist-title">{article.data.title}</div>
                            <div class="playlist-subtitle">{article.data.subtitle}</div>
                            <div class="playlist-meta">
                                <span class="playlist-author">{article.data.author}</span>
                                <span class="playlist-date">{formatDate(article.data.date)}</span>
                            </div>
                            <div class="playlist-tags">
                                {article.data.tags.map(tag => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                        <div class="playlist-player">
                            <audio class="podcast-player" data-index={index} data-article-title={article.data.title} data-audio-type="podcast" controls preload="none">
                                <source src={article.data.podcast} type="audio/mpeg">
                            </audio>
                        </div>
                    </div>
                ))}
            </div>
        </div>
        
        <!-- Videos Tab Content -->
        <div id="videos-tab" class="tab-content">
            <div class="videos-grid">
                {additionalVideos.map((video, index) => (
                    <div class="video-card" data-index={index}>
                        <div class="video-thumbnail-container">
                            <a 
                                href={`https://www.youtube.com/watch?v=${video.videoId}`} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="video-thumbnail-link"
                            >
                                <img 
                                    src={`https://img.youtube.com/vi/${video.videoId}/mqdefault.jpg`} 
                                    alt={video.title}
                                    loading="lazy"
                                    class="video-thumbnail"
                                />
                                <div class="video-play-overlay">
                                    <i class="fas fa-play"></i>
                                </div>
                            </a>
                        </div>
                        <div class="video-info">
                            <h3 class="video-title">
                                <a href={`https://www.youtube.com/watch?v=${video.videoId}`} target="_blank" rel="noopener noreferrer">
                                    {video.title}
                                </a>
                            </h3>
                            <p class="video-subtitle">{video.subtitle}</p>
                            <div class="video-meta">
                                <span class="video-author">by {video.author}</span>
                                <span class="video-date">{formatDate(video.date)}</span>
                            </div>
                            <div class="video-tags">
                                {video.tags.map(tag => (
                                    <span class="tag">{tag}</span>
                                ))}
                            </div>
                        </div>
                    </div>
                ))}

            </div>
        </div>
        
        <!-- Art Tab Content -->
        <div id="art-tab" class="tab-content">
            <div class="art-grid">
                <div class="art-card">
                    <div class="art-preview-container">
                        <a href="/art/corners/index.html" target="_blank" rel="noopener noreferrer" class="art-preview-link">
                            <img src="/art/corners/preview.png" alt="corners" class="art-preview-img" />
                            <div class="art-play-overlay">
                                <i class="fas fa-external-link-alt"></i>
                            </div>
                        </a>
                    </div>
                    <div class="art-info">
                        <h3 class="art-title">
                            <a href="/art/corners/index.html" target="_blank" rel="noopener noreferrer">
                                corners
                            </a>
                        </h3>
                        <p class="art-description">
                            A recreation of a PosterLad piece, transformed from static poster to interactive
                            digital surface. Hover over any box and every corner radius shifts with deeply
                            satisfying, smooth motions. It is about <em>presence</em> — being with something
                            that changes when you touch it.
                        </p>
                        <a href="/art/corners/index.html" target="_blank" rel="noopener noreferrer" class="art-link">
                            Open →
                        </a>
                    </div>
                </div>
                
                <div class="art-card">
                    <div class="art-preview-container">
                        <a href="/art/corners-ball/index.html" target="_blank" rel="noopener noreferrer" class="art-preview-link">
                            <img src="/art/corners-ball/preview.png" alt="corners-ball" class="art-preview-img" />
                            <div class="art-play-overlay">
                                <i class="fas fa-external-link-alt"></i>
                            </div>
                        </a>
                    </div>
                    <div class="art-info">
                        <h3 class="art-title">
                            <a href="/art/corners-ball/index.html" target="_blank" rel="noopener noreferrer">
                                corners-ball
                            </a>
                        </h3>
                        <p class="art-description">
                            What if beauty was the purpose of life? Orange circles anchor the world in cream.
                            Chase them away and the whole page flips into darkness. It is about
                            <em>consequence</em> — your choices dissolve the world into its inverse, and you decide
                            whether to bring the circles back or let it stay flipped.
                        </p>
                        <a href="/art/corners-ball/index.html" target="_blank" rel="noopener noreferrer" class="art-link">
                            Open →
                        </a>
                    </div>
                </div>
                
                <!-- stillness -->
                <div class="art-card">
                    <div class="art-preview-container">
                        <a href="/art/stillness/index.html" target="_blank" rel="noopener noreferrer" class="art-preview-link">
                            <img src="/art/stillness/preview.png" alt="stillness" class="art-preview-img" />
                            <div class="art-play-overlay">
                                <i class="fas fa-external-link-alt"></i>
                            </div>
                        </a>
                    </div>
                    <div class="art-info">
                        <h3 class="art-title">
                            <a href="/art/stillness/index.html" target="_blank" rel="noopener noreferrer">
                                stillness
                            </a>
                        </h3>
                        <p class="art-description">
                            Some great things happen when you're bored. It is the stillness that creates
                            the fertile ground upon which the seeds of new ideas can be sown. Open it,
                            sit still, do nothing, and see what happens.
                        </p>
                        <a href="/art/stillness/index.html" target="_blank" rel="noopener noreferrer" class="art-link">
                            Open →
                        </a>
                    </div>
                </div>

                <!-- sal -->
                <div class="art-card">
                    <div class="art-preview-container">
                        <a href="/art/sal/index.html" target="_blank" rel="noopener noreferrer" class="art-preview-link">
                            <img src="/art/sal/preview.png" alt="sal" class="art-preview-img" />
                            <div class="art-play-overlay">
                                <i class="fas fa-external-link-alt"></i>
                            </div>
                        </a>
                    </div>
                    <div class="art-info">
                        <h3 class="art-title">
                            <a href="/art/sal/index.html" target="_blank" rel="noopener noreferrer">
                                sal
                            </a>
                        </h3>
                        <p class="art-description">
                            One thing missing from most interfaces is personality. Sal is a coin-swap
                            interface with a soul. Pause at an input box and Sal drifts off and dreams.
                            Type a large amount and he cautions you to be careful. Hit submit and he leaves
                            the room, turning off the lights because he cares about the environment. It is
                            about <em>desire</em> — the quiet hunger of a surface that only becomes real when you touch it.
                        </p>
                        <a href="/art/sal/index.html" target="_blank" rel="noopener noreferrer" class="art-link">
                            Open →
                        </a>
                    </div>
                </div>
                
                <!-- lawascode -->
                <div class="art-card">
                    <div class="art-preview-container">
                        <a href="/art/lawascode/index.html" target="_blank" rel="noopener noreferrer" class="art-preview-link">
                            <img src="/art/lawascode/preview.png" alt="lawascode" class="art-preview-img" />
                            <div class="art-play-overlay">
                                <i class="fas fa-external-link-alt"></i>
                            </div>
                        </a>
                    </div>
                    <div class="art-info">
                        <h3 class="art-title">
                            <a href="/art/lawascode/index.html" target="_blank" rel="noopener noreferrer">
                                lawascode
                            </a>
                        </h3>
                        <p class="art-description">
                            Legal text converted into code. A side-by-side comparison of property transfer
                            laws in India and Spain, written as Python. It is about <em>structure</em> —
                            examining how two countries encode the same human need into entirely different
                            legal architectures.
                        </p>
                        <a href="/art/lawascode/index.html" target="_blank" rel="noopener noreferrer" class="art-link">
                            Open →
                        </a>
                    </div>
                </div>
            </div>
        </div>
        
        <!-- Posts Tab Content -->
        <div id="posts-tab" class="tab-content">
            <div class="tags-cloud">
                <button class="tag-filter active" data-tag="all">All</button>
                {allTags.map(tag => (
                    <button class="tag-filter" data-tag={tag}>#{tag}</button>
                ))}
            </div>
            <div class="posts-grid">
                {posts.map((post, index) => (
                    <div class="post-card" data-tags={post.data.tags.join(' ')}>
                        {post.data.image && (
                            <div class="post-image">
                                <img src={post.data.image} alt="" loading="lazy">
                            </div>
                        )}
                        <div class="post-body">
                            <div class={`post-content ${!post.data.image ? 'post-content--no-image' : ''} ${post.body.length < 200 ? 'post-content--short' : ''}`}>
                                {post.body}
                            </div>
                            <div class="post-meta">
                                <span class="post-date">{formatDate(post.data.date)}</span>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</BaseLayout>

<script>
    // Function to activate a tab by name
    function activateTab(tabName) {
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabContents = document.querySelectorAll('.tab-content');
        const mobileMenuItems = document.querySelectorAll('.mobile-menu-item');
        
        tabButtons.forEach(button => {
            button.classList.remove('active');
        });
        mobileMenuItems.forEach(item => {
            item.classList.remove('active');
        });
        tabContents.forEach(content => {
            content.classList.remove('active');
        });
        
        const targetButton = document.querySelector(`.tab-button[data-tab="${tabName}"]`);
        if (targetButton) {
            targetButton.classList.add('active');
        }
        
        const targetMobileItem = document.querySelector(`.mobile-menu-item[data-tab="${tabName}"]`);
        if (targetMobileItem) {
            targetMobileItem.classList.add('active');
        }
        
        const targetContent = document.getElementById(`${tabName}-tab`);
        if (targetContent) {
            targetContent.classList.add('active');
        }
    }
    
    document.addEventListener('DOMContentLoaded', function() {
        const tabButtons = document.querySelectorAll('.tab-button');
        const tabContents = document.querySelectorAll('.tab-content');
        const mobileMenuItems = document.querySelectorAll('.mobile-menu-item');
        const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
        const mobileMenuDropdown = document.querySelector('.mobile-menu-dropdown');
        
        // Desktop tab buttons
        tabButtons.forEach(button => {
            button.addEventListener('click', (e) => {
                e.preventDefault();
                window.location.hash = '#' + button.dataset.tab;
            });
        });
        
        // Mobile menu items
        mobileMenuItems.forEach(item => {
            item.addEventListener('click', (e) => {
                e.preventDefault();
                window.location.hash = '#' + item.dataset.tab;
                // Close mobile menu
                mobileMenuDropdown?.classList.remove('active');
                if (mobileMenuToggle) {
                    mobileMenuToggle.innerHTML = '<i class="fas fa-bars"></i>';
                }
            });
        });
        
        // Mobile menu toggle
        mobileMenuToggle?.addEventListener('click', () => {
            const isActive = mobileMenuDropdown?.classList.contains('active');
            
            if (isActive) {
                mobileMenuDropdown?.classList.remove('active');
                mobileMenuToggle.innerHTML = '<i class="fas fa-bars"></i>';
            } else {
                mobileMenuDropdown?.classList.add('active');
                mobileMenuToggle.innerHTML = '<i class="fas fa-times"></i>';
            }
        });
        
        const tagFilters = document.querySelectorAll('.tag-filter');
        
        tagFilters.forEach(filter => {
            filter.addEventListener('click', () => {
                const tag = filter.dataset.tag;
                const scope = filter.dataset.scope || 'posts';
                const container = scope === 'articles' ? '.articles-list' : '.posts-grid';
                const items = document.querySelectorAll(`${container} > *`);
                const cloud = filter.closest('.tags-cloud');
                const filters = cloud?.querySelectorAll('.tag-filter');
                
                filters?.forEach(f => f.classList.remove('active'));
                filter.classList.add('active');
                
                items.forEach(item => {
                    if (tag === 'all') {
                        item.classList.remove('hidden-by-filter');
                    } else {
                        const tags = item.dataset.tags || '';
                        const itemTags = tags.toLowerCase().split(/\s+/).filter(Boolean);
                        if (itemTags.includes(tag.toLowerCase())) {
                            item.classList.remove('hidden-by-filter');
                        } else {
                            item.classList.add('hidden-by-filter');
                        }
                    }
                });
            });
        });
        
        // Audio playlist functionality
        (function() {
            const DELAY_BETWEEN_TRACKS = 5000;
            
            const audioPlayers = document.querySelectorAll('.audio-player');
            const podcastPlayers = document.querySelectorAll('.podcast-player');
            const audioItems = document.querySelectorAll('#audio-tab .playlist-item');
            const podcastItems = document.querySelectorAll('#podcasts-tab .playlist-item');
            
            audioPlayers.forEach((player, index) => {
                player.addEventListener('play', () => {
                    audioPlayers.forEach((p, i) => {
                        if (i !== index) p.pause();
                    });
                    podcastPlayers.forEach(p => p.pause());
                    
                    audioItems.forEach((item, i) => {
                        item.classList.toggle('playing', i === index);
                    });
                    podcastItems.forEach(item => {
                        item.classList.remove('playing');
                    });
                });
                
                player.addEventListener('ended', () => {
                    audioItems[index]?.classList.remove('playing');
                    
                    const nextIndex = index + 1;
                    if (nextIndex < audioPlayers.length) {
                        setTimeout(() => {
                            audioPlayers[nextIndex].play();
                        }, DELAY_BETWEEN_TRACKS);
                    }
                });
                
                player.addEventListener('pause', () => {
                    if (!player.ended) {
                        audioItems[index]?.classList.remove('playing');
                    }
                });
            });
            
            podcastPlayers.forEach((player, index) => {
                player.addEventListener('play', () => {
                    podcastPlayers.forEach((p, i) => {
                        if (i !== index) p.pause();
                    });
                    audioPlayers.forEach(p => p.pause());
                    
                    podcastItems.forEach((item, i) => {
                        item.classList.toggle('playing', i === index);
                    });
                    audioItems.forEach(item => {
                        item.classList.remove('playing');
                    });
                });
                
                player.addEventListener('ended', () => {
                    podcastItems[index]?.classList.remove('playing');
                    
                    const nextIndex = index + 1;
                    if (nextIndex < podcastPlayers.length) {
                        setTimeout(() => {
                            podcastPlayers[nextIndex].play();
                        }, DELAY_BETWEEN_TRACKS);
                    }
                });
                
                player.addEventListener('pause', () => {
                    if (!player.ended) {
                        podcastItems[index]?.classList.remove('playing');
                    }
                });
            });
        })();
        
        // Handle tab activation from URL hash on page load
        function initTabFromHash() {
            const hash = window.location.hash.slice(1); // Remove '#'
            activateTab(hash || 'articles');
        }
        
        // Listen for hash changes (e.g., browser back/forward)
        window.addEventListener('hashchange', () => {
            const hash = window.location.hash.slice(1);
            activateTab(hash || 'articles');
        });
        
        // Initialize on page load
        initTabFromHash();
    });
</script>

<script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
        // Tab switch tracking
        const tabObserver = new MutationObserver(function(mutations) {
            mutations.forEach(function(mutation) {
                if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
                    const el = mutation.target;
                    if (el.classList.contains('tab-content') && el.classList.contains('active')) {
                        const tabName = el.id.replace('-tab', '');
                        if (window.posthog) {
                            window.posthog.capture('tab_switch', {
                                tab_name: tabName,
                                page_path: location.pathname
                            });
                        }
                    }
                }
            });
        });
        document.querySelectorAll('.tab-content').forEach(tab => {
            tabObserver.observe(tab, { attributes: true, attributeFilter: ['class'] });
        });

        // Tag filter tracking
        document.querySelectorAll('.tag-filter').forEach(filter => {
            filter.addEventListener('click', function() {
                const tag = filter.dataset.tag;
                const scope = filter.dataset.scope || 'posts';
                if (window.posthog && tag && tag !== 'all') {
                    window.posthog.capture('tag_filter', {
                        tag: tag,
                        scope: scope,
                        page_path: location.pathname
                    });
                }
            });
        });

        // Audio tracking for index page
        function trackIndexAudio(containerSelector, defaultType) {
            const container = document.querySelector(containerSelector);
            if (!container) return;
            window.xfAnalytics.initAudioTracking(
                container,
                audio => audio.dataset.audioType || defaultType,
                audio => audio.dataset.articleTitle || 'unknown'
            );
        }
        trackIndexAudio('#audio-tab', 'reader');
        trackIndexAudio('#podcasts-tab', 'podcast');

        // Video thumbnail click tracking
        document.querySelectorAll('.video-thumbnail-link').forEach(link => {
            link.addEventListener('click', function(e) {
                const card = link.closest('.video-card');
                const titleEl = card?.querySelector('.video-title');
                const title = titleEl ? titleEl.textContent.trim() : 'unknown';
                const href = link.getAttribute('href') || '';
                const videoIdMatch = href.match(/v=([a-zA-Z0-9_-]+)/);
                if (window.posthog) {
                    window.posthog.capture('video_thumbnail_click', {
                        video_title: title,
                        video_id: videoIdMatch ? videoIdMatch[1] : 'unknown',
                        page_path: location.pathname
                    });
                }
            });
        });

        // Art piece click tracking
        document.querySelectorAll('.art-preview-link, .art-link').forEach(link => {
            link.addEventListener('click', function(e) {
                const href = link.getAttribute('href') || '';
                const slugMatch = href.match(/\/art\/([^/]+)\//);
                const slug = slugMatch ? slugMatch[1] : 'unknown';
                if (window.posthog) {
                    window.posthog.capture('art_piece_open', {
                        art_slug: slug,
                        page_path: location.pathname
                    });
                }
            });
        });
    });
</script>
